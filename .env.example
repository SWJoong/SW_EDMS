# ====================================================================
# 환경변수 예시 — 이 파일(.env.example)만 커밋하고, 실제 값은 .env 에 넣어 커밋하지 마세요.
# ====================================================================
#
# ⚠️ Vite 는 VITE_ 접두 변수를 "프런트엔드 번들에 그대로" 포함시킵니다(브라우저에서 보입니다).
#    따라서 여기에는 "공개돼도 되는 값"만 넣어야 합니다.
#
#   ✅ 넣어도 되는 것: Supabase URL, Supabase ANON 키, Kakao JavaScript 키(도메인 제한 필수)
#   ❌ 절대 금지     : Supabase service_role 키, DB 비밀번호, 기타 서버 전용 비밀키
#
#    service_role 키는 RLS 를 우회하는 "마스터 키"입니다. 프런트에 실리면
#    누구나 전 직원 결재·개인정보를 읽고 지울 수 있습니다. 서버(Edge Function 등)에만 두세요.
#    (이 사고를 .github/workflows/security-guard.yml 가 CI 에서 차단합니다.)
# ====================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_KAKAO_JS_KEY=your-kakao-javascript-key-here
